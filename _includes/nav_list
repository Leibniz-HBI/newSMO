{% assign locale = include.locale | default: site.locale %}

<nav class="nav__list">
  {% if page.sidebar.title %}<h3 class="nav__title" style="padding-inline-start: 0;">{{ page.sidebar.title }}</h3>{% endif %}
  <input id="ac-toc" name="accordion-toc" type="checkbox" />
  <label for="ac-toc">{{ site.data.ui-text[locale].menu_label | default: "Toggle Menu" }}</label>
  <ul class="nav__items">
    {% for navname in include.nav %}
      {% assign navigation = site.data.navigation[navname] %}
      {% for nav in navigation %}
        <li>
          {% if nav.url %}
            <a href="{{ nav.url | relative_url }}"><span class="nav__sub-title">{{ nav.title }}</span></a>
          {% else %}
            <span class="nav__sub-title">{{ nav.title }}</span>
          {% endif %}

          {% if nav.children != null %}
            <ul>
              {% for child in nav.children %}
                {% comment %}
                  Minimal Mistakes normally activates a sidebar child only when
                  child.url == page.url.  That misses /tags/publication vs
                  /tags/publication/ and, by definition, publication detail posts.

                  Normalize slashes for ordinary pages and additionally treat every
                  post tagged "publication" as belonging to the Publications section.
                {% endcomment %}
                {% assign child_url_normalized = child.url | remove: "/" %}
                {% assign page_url_normalized = page.url | remove: "/" %}
                {% assign child_is_active = false %}

                {% if child_url_normalized == page_url_normalized %}
                  {% assign child_is_active = true %}
                {% endif %}

                {% if page.tags contains "publication" and child.url contains "/tags/publication" %}
                  {% assign child_is_active = true %}
                {% endif %}

                <li><a href="{{ child.url | relative_url }}"{% if child_is_active %} class="active"{% endif %}>{{ child.title }}</a></li>
              {% endfor %}
            </ul>
          {% endif %}
        </li>
      {% endfor %}
    {% endfor %}
  </ul>
</nav>
